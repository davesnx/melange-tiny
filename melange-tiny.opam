# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
synopsis:
  "Small replacements of OCaml stdlib modules for Melange, to keep JavaScript bundles small"
description:
  "Printf, Hashtbl, Random and Digest (MD5) subsets that compile to small JavaScript with Melange and run on native OCaml too."
maintainer: ["David Sancho Moreno"]
authors: ["David Sancho Moreno"]
license: "MIT"
homepage: "https://github.com/davesnx/melange-tiny"
bug-reports: "https://github.com/davesnx/melange-tiny/issues"
depends: [
  "dune" {>= "3.16"}
  "ocaml" {>= "5.4"}
  "melange" {>= "7.0.1-54"}
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/davesnx/melange-tiny.git"
