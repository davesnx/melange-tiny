(melange.emit
 (target output)
 (libraries
  app
  melange-tiny.printf.js
  melange-tiny.hashtbl.js
  melange-tiny.random.js))

(rule
 (deps
  (alias melange))
 (action
  (with-stdout-to
   main.output
   (run node output/example/web/main.js))))

(rule
 (alias runtest)
 (action
  (diff ../native/main.expected main.output)))
